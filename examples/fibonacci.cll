import std;

// tunnels int32 result
def fib(int32 n)
{
    int32 a = 0;
    int32 b = 1;
    int32 tmp = 0;

    for (int32 i = 0; i < n;)
    {
        tmp = b;
        b = a + b;
        a = tmp;
        i += 1;
    }

    tunnel a -> int32 result;
}

entry
{
    for (int32 i = 0; i < 16;)
    {
        reserve int32 result = fib(i);
        printf("fib(%2d) = %d\n", i, result);
        i += 1;
    }
}
