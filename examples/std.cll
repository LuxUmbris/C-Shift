import float64 sin      (float64 x);
import float64 cos      (float64 x);
import float64 tan      (float64 x);
import float64 asin     (float64 x);
import float64 acos     (float64 x);
import float64 atan     (float64 x);
import float64 atan2    (float64 y, float64 x);
import float64 sinh     (float64 x);
import float64 cosh     (float64 x);
import float64 tanh     (float64 x);
