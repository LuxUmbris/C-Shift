// ════════════════════════════════════════════════════════════
//  §20  C<< Runtime Helpers  —  frt.c
//  These are thin wrappers that don't exist in libc directly.
//  Implement them in a small frt.c file linked with every binary.
// ════════════════════════════════════════════════════════════

// errno access (errno is a C macro, not a function)
import int32   get_errno   ();
import voided  set_errno   (int32 val);

// Safe integer overflow checks
import int32   add_i32_safe (int32 a, int32 b, int32* out);
import int32   mul_i32_safe (int32 a, int32 b, int32* out);

// Heap string builder (returns malloc'd string — caller must free)
import string  str_concat   (string a, string b);
import string  str_repeat   (string s, int32 n);
import string  str_slice    (string s, int32 start, int32 end);
import int32   str_index_of (string s, string needle);
import string  str_replace  (string s, string from, string to);
import string  int_to_str   (int64 val);
import string  float_to_str (float64 val, int32 precision);

// I/O helpers
import string  read_line    ();                  // reads one line from stdin, malloc'd
import string  read_file_s  (string path);       // entire file into malloc'd string
import int32   write_file_s (string path, string contents);

// Timing
import float64 now_seconds  ();                  // monotonic clock in seconds


// ════════════════════════════════════════════════════════════
//  §21  Comfort Containers  —  Zero-Copy Chunked Structures
//  Generic type-safe containers with efficient memory management.
//  Template instantiation happens at compile time.
// ════════════════════════════════════════════════════════════

/* ─── Vector<T>: Dynamic array with chunk-based allocation ─── */

template<typename T>
struct Vector
{
  voided* chunks;           /* array of chunk pointers (no copies) */
  uint64  chunk_size;       /* elements per chunk (power of 2) */
  uint64  num_chunks;       /* how many chunks allocated */
  uint64  len;              /* total elements in vector */
};

template<typename T>
import voided* vec_new         (uint64 chunk_size);
template<typename T>
import voided  vec_free        (Vector<T>* v);
template<typename T>
import int32   vec_push        (Vector<T>* v, T elem);
template<typename T>
import int32   vec_pop         (Vector<T>* v, T* out);
template<typename T>
import T       vec_get         (Vector<T>* v, uint64 idx);
template<typename T>
import int32   vec_set         (Vector<T>* v, uint64 idx, T elem);
template<typename T>
import uint64  vec_len         (Vector<T>* v);
template<typename T>
import int32   vec_insert      (Vector<T>* v, uint64 idx, T elem);
template<typename T>
import int32   vec_remove      (Vector<T>* v, uint64 idx, T* out);
template<typename T>
import voided  vec_clear       (Vector<T>* v);
template<typename T>
import int32   vec_reserve     (Vector<T>* v, uint64 capacity);

/* Zero-copy iterators */
template<typename T>
struct VecIter
{
  Vector<T>* vec;
  uint64 idx;
};

template<typename T>
import VecIter<T> vec_iter_begin (Vector<T>* v);
template<typename T>
import int32       vec_iter_next  (VecIter<T>* it, T* out);


/* ─── HashMap<K, V>: Hash table with chaining ─── */

template<typename K>
template<typename V>
struct HashMap
{
  voided* buckets;          /* array of bucket lists */
  uint64  num_buckets;      /* hash table size */
  uint64  load_factor;      /* entries / num_buckets */
  uint64  capacity;         /* max before rehash */
};

template<typename K>
template<typename V>
import voided* map_new    ();
template<typename K>
template<typename V>
import voided  map_free   (HashMap<K, V>* m);
template<typename K>
template<typename V>
import int32   map_insert (HashMap<K, V>* m, K key, V value);
template<typename K>
template<typename V>
import int32   map_remove (HashMap<K, V>* m, K key);
template<typename K>
template<typename V>
import int32   map_get    (HashMap<K, V>* m, K key, V* out);
template<typename K>
template<typename V>
import int32   map_contains (HashMap<K, V>* m, K key);
template<typename K>
template<typename V>
import uint64  map_len    (HashMap<K, V>* m);
template<typename K>
template<typename V>
import voided  map_clear  (HashMap<K, V>* m);


/* ─── LinkedList<T>: Intrusive doubly-linked list ─── */

template<typename T>
struct LinkedList
{
  voided* head;
  voided* tail;
  uint64  len;
};

template<typename T>
struct LinkNode
{
  T       data;
  voided* prev;
  voided* next;
};

template<typename T>
import voided* list_new     ();
template<typename T>
import voided  list_free    (LinkedList<T>* l);
template<typename T>
import int32   list_push_front (LinkedList<T>* l, T elem);
template<typename T>
import int32   list_push_back  (LinkedList<T>* l, T elem);
template<typename T>
import int32   list_pop_front  (LinkedList<T>* l, T* out);
template<typename T>
import int32   list_pop_back   (LinkedList<T>* l, T* out);
template<typename T>
import uint64  list_len    (LinkedList<T>* l);
template<typename T>
import voided  list_clear  (LinkedList<T>* l);


/* ─── Set<T>: Hash set (uses HashMap internally) ─── */

template<typename T>
struct Set
{
  voided* map;              /* HashMap<T, bool> */
};

template<typename T>
import voided* set_new      ();
template<typename T>
import voided  set_free     (Set<T>* s);
template<typename T>
import int32   set_insert   (Set<T>* s, T elem);
template<typename T>
import int32   set_remove   (Set<T>* s, T elem);
template<typename T>
import int32   set_contains (Set<T>* s, T elem);
template<typename T>
import uint64  set_len      (Set<T>* s);
template<typename T>
import voided  set_clear    (Set<T>* s);


/* ─── Deque<T>: Double-ended queue with ring buffer ─── */

template<typename T>
struct Deque
{
  voided* buffer;           /* circular ring buffer */
  uint64  capacity;
  uint64  front;            /* head index */
  uint64  rear;             /* tail index */
  uint64  len;
};

template<typename T>
import voided* deque_new      (uint64 capacity);
template<typename T>
import voided  deque_free     (Deque<T>* d);
template<typename T>
import int32   deque_push_front (Deque<T>* d, T elem);
template<typename T>
import int32   deque_push_back  (Deque<T>* d, T elem);
template<typename T>
import int32   deque_pop_front  (Deque<T>* d, T* out);
template<typename T>
import int32   deque_pop_back   (Deque<T>* d, T* out);
template<typename T>
import T       deque_at     (Deque<T>* d, uint64 idx);
template<typename T>
import uint64  deque_len    (Deque<T>* d);
template<typename T>
import voided  deque_clear  (Deque<T>* d);


/* ─── RingBuffer<T>: Fixed-size circular buffer (lock-free safe) ─── */

template<typename T>
struct RingBuffer
{
  voided* buffer;           /* pre-allocated array */
  uint64  capacity;         /* max elements */
  uint64  write_pos;        /* write index (atomic) */
  uint64  read_pos;         /* read index (atomic) */
};

template<typename T>
import voided* ring_new     (uint64 capacity);
template<typename T>
import voided  ring_free    (RingBuffer<T>* rb);
template<typename T>
import int32   ring_push    (RingBuffer<T>* rb, T elem);   /* returns 0 if full */
template<typename T>
import int32   ring_pop     (RingBuffer<T>* rb, T* out);   /* returns 0 if empty */
template<typename T>
import uint64  ring_available_read  (RingBuffer<T>* rb);
template<typename T>
import uint64  ring_available_write (RingBuffer<T>* rb);
template<typename T>
import voided  ring_clear   (RingBuffer<T>* rb);


/* ─── Pool<T>: Object pool for allocation-free usage patterns ─── */

template<typename T>
struct Pool
{
  voided* free_list;        /* linked list of free objects */
  voided* allocated;        /* all allocated blocks */
  uint64  obj_size;
  uint64  num_free;
};

template<typename T>
import voided* pool_new     (uint64 num_objects);
template<typename T>
import voided  pool_free    (Pool<T>* p);
template<typename T>
import T*      pool_acquire (Pool<T>* p);
template<typename T>
import voided  pool_release (Pool<T>* p, T* obj);
template<typename T>
import uint64  pool_available (Pool<T>* p);
template<typename T>
import voided  pool_reset   (Pool<T>* p);


/* ─── Pair<A, B>: Simple tuple ─── */

template<typename A>
template<typename B>
struct Pair
{
  A first;
  B second;
};

template<typename A>
template<typename B>
import Pair<A, B> pair_make (A a, B b);


/* ─── BitSet: Compact bitfield operations ─── */

struct BitSet
{
  voided* bits;
  uint64  capacity;         /* in bits */
};

import voided* bitset_new    (uint64 num_bits);
import voided  bitset_free   (BitSet* bs);
import int32   bitset_set    (BitSet* bs, uint64 idx);
import int32   bitset_clear  (BitSet* bs, uint64 idx);
import int32   bitset_toggle (BitSet* bs, uint64 idx);
import int32   bitset_get    (BitSet* bs, uint64 idx);
import uint64  bitset_count  (BitSet* bs);           /* count set bits */
import voided  bitset_and    (BitSet* dst, BitSet* src);
import voided  bitset_or     (BitSet* dst, BitSet* src);
import voided  bitset_xor    (BitSet* dst, BitSet* src);
import voided  bitset_not    (BitSet* bs);


/* ─── Lazy<T>: Compute-on-demand caching ─── */

template<typename T>
struct Lazy
{
  voided* compute_fn;       /* function pointer: voided*() -> T */
  T       cached;
  int32   computed;
};

template<typename T>
import Lazy<T> lazy_new     (voided* fn);
template<typename T>
import T       lazy_force   (Lazy<T>* l);
template<typename T>
import int32   lazy_is_computed (Lazy<T>* l);


/* ─── Scope Guards: RAII-style cleanup ─── */

struct Guard
{
  voided* cleanup_fn;       /* function pointer: voided(voided*) */
  voided* context;
};

import Guard   guard_new    (voided* cleanup_fn, voided* ctx);
import voided  guard_dismiss(Guard* g);              /* prevent cleanup */


/* ─── String Builder: Efficient string concatenation ─── */

struct StringBuilder
{
  voided* buffer;           /* chunked vector of chars */
  uint64  len;
};

import voided* sb_new       ();
import voided  sb_free      (StringBuilder* sb);
import int32   sb_append    (StringBuilder* sb, string s);
import int32   sb_append_char (StringBuilder* sb, char c);
import int32   sb_append_int   (StringBuilder* sb, int64 val);
import int32   sb_append_float (StringBuilder* sb, float64 val, int32 prec);
import string  sb_build     (StringBuilder* sb);     /* malloc'd string */
import voided  sb_clear     (StringBuilder* sb);


/* ─── Buffer<T>: Safe typed buffers ─── */

template<typename T>
struct Buffer
{
  T*     data;
  uint64 len;
  uint64 capacity;
};

template<typename T>
import Buffer<T> buf_new     (uint64 capacity);
template<typename T>
import voided    buf_free    (Buffer<T>* b);
template<typename T>
import int32     buf_resize  (Buffer<T>* b, uint64 new_size);
template<typename T>
import int32     buf_push    (Buffer<T>* b, T elem);
template<typename T>
import T         buf_pop     (Buffer<T>* b);
template<typename T>
import voided    buf_fill    (Buffer<T>* b, T val);
template<typename T>
import voided    buf_copy    (Buffer<T>* dst, Buffer<T>* src);


/* ─── Sorted Containers ─── */

template<typename T>
struct SortedVec
{
  voided* vec;              /* Vector<T> internally */
  voided* cmp_fn;           /* comparison function */
};

template<typename T>
import voided* svec_new     (voided* cmp_fn);
template<typename T>
import voided  svec_free    (SortedVec<T>* sv);
template<typename T>
import int32   svec_insert  (SortedVec<T>* sv, T elem);
template<typename T>
import int32   svec_remove  (SortedVec<T>* sv, T elem);
template<typename T>
import int32   svec_find    (SortedVec<T>* sv, T elem);
template<typename T>
import uint64  svec_len     (SortedVec<T>* sv);
