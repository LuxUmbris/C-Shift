{
  "name": "cshift-language",
  "displayName": "C<< (C-Shift) Language Support",
  "icon": "cll_logo.png",
  "description": "Syntax highlighting, IntelliSense, real compiler error highlighting, and autocomplete for C<<",
  "version": "1.3.0",
  "author": "LuxUmbris",
  "license": "Apache 2.0",
  "publisher": "cshift",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "c-shift",
    "cll",
    "systems",
    "language",
    "compiler",
    "arena",
    "vop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxUmbris/C-Shift"
  },
  "bugs": {
    "url": "https://github.com/LuxUmbris/C-Shift/issues"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cshift"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cshift",
        "aliases": [
          "C<<",
          "C-Shift",
          "cshift"
        ],
        "extensions": [
          ".cll"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cshift",
        "scopeName": "source.cshift",
        "path": "./syntaxes/cshift.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cshift",
        "path": "./snippets/cshift.json"
      }
    ],
    "commands": [
      {
        "command": "cshift.compileFile",
        "title": "Compile C<< File",
        "category": "C<<"
      },
      {
        "command": "cshift.checkSyntax",
        "title": "Check Syntax (no build)",
        "category": "C<<"
      },
      {
        "command": "cshift.formatDocument",
        "title": "Format Document",
        "category": "C<<"
      },
      {
        "command": "cshift.listKeywords",
        "title": "List All Keywords",
        "category": "C<<"
      },
      {
        "command": "cshift.listOperators",
        "title": "List All Operators",
        "category": "C<<"
      },
      {
        "command": "cshift.showVersion",
        "title": "Show Compiler Version",
        "category": "C<<"
      }
    ],
    "keybindings": [
      {
        "command": "cshift.compileFile",
        "key": "ctrl+shift+b",
        "when": "editorLangId == cshift"
      },
      {
        "command": "cshift.checkSyntax",
        "key": "ctrl+shift+k",
        "when": "editorLangId == cshift"
      },
      {
        "command": "cshift.formatDocument",
        "key": "alt+shift+f",
        "when": "editorLangId == cshift"
      },
      {
        "command": "cshift.showVersion",
        "key": "ctrl+shift+v",
        "when": "editorLangId == cshift"
      }
    ],
    "configuration": {
      "title": "C<< Language",
      "properties": {
        "cshift.compilerPath": {
          "type": "string",
          "default": "cshift",
          "description": "Path to the cshift compiler binary. Defaults to 'cshift' (must be on PATH)."
        },
        "cshift.stdPath": {
          "type": "string",
          "default": "",
          "description": "Path to the directory containing std.cll (sets CSHIFT_STD_PATH). Leave empty to use the default."
        },
        "cshift.checkDelay": {
          "type": "number",
          "default": 800,
          "description": "Milliseconds to wait after the last keystroke before running the checker."
        },
        "cshift.enableRealTimeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Run cshift --check-only in the background and show errors/warnings inline."
        }
      }
    },
    "configurationDefaults": {
      "[cshift]": {
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
          100
        ]
      }
    }
  },
  "scripts": {
    "test": "node ./test.js"
  },
  "devDependencies": {
    "vscode": "^1.1.37"
  }
}