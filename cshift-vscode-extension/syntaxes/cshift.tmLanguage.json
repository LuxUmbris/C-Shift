{
  "name": "C<< (C-Shift)",
  "scopeName": "source.cshift",
  "fileTypes": ["cll"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw_strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#voided_guard" },
    { "include": "#keywords_control" },
    { "include": "#keywords_decl" },
    { "include": "#keywords_vop" },
    { "include": "#types_generic" },
    { "include": "#types_primitive" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#arena_ops" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cshift",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cshift",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.cshift" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.cshift" } }
        }
      ]
    },

    "raw_strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.cshift",
          "begin": "\\braw<until\\s+\"([^\"]+)\">",
          "end": "^\\s*\\1\\s*$",
          "beginCaptures": { "0": { "name": "keyword.other.raw.cshift" } }
        },
        {
          "name": "string.quoted.other.raw-lines.cshift",
          "begin": "\\braw<(\\d+)>",
          "end": "(?<=\\n)(?:(?:[^\\n]*\\n){0,})",
          "beginCaptures": { "0": { "name": "keyword.other.raw.cshift" } }
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.cshift",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.cshift", "match": "\\\\[nrt0\\\\\"']" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cshift",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.cshift",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.cshift",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "voided_guard": {
      "comment": "switch(var) { case valid: … case voided: … } — special colouring",
      "patterns": [
        {
          "name": "keyword.control.voided-guard.cshift",
          "match": "\\b(valid|voided)\\b"
        },
        {
          "name": "keyword.control.move.cshift",
          "match": "\\bmove\\b"
        }
      ]
    },

    "keywords_control": {
      "name": "keyword.control.cshift",
      "match": "\\b(if|else|while|for|foreach|switch|case|default|break|continue|return)\\b"
    },

    "keywords_decl": {
      "patterns": [
        {
          "comment": "export def — export is a modifier on def",
          "match": "\\b(export)\\s+(def)\\b",
          "captures": {
            "1": { "name": "storage.modifier.export.cshift" },
            "2": { "name": "storage.type.function.cshift" }
          }
        },
        {
          "name": "storage.type.function.cshift",
          "match": "\\bdef\\b"
        },
        {
          "name": "storage.type.struct.cshift",
          "match": "\\bstruct\\b"
        },
        {
          "name": "storage.type.enum.cshift",
          "match": "\\benum\\b"
        },
        {
          "name": "storage.type.namespace.cshift",
          "match": "\\bnamespace\\b"
        },
        {
          "name": "storage.type.template.cshift",
          "match": "\\btemplate\\b"
        },
        {
          "name": "storage.modifier.const.cshift",
          "match": "\\bconst\\b"
        },
        {
          "name": "keyword.other.entry.cshift",
          "match": "\\bentry\\b"
        },
        {
          "name": "keyword.other.import.cshift",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.other.typename.cshift",
          "match": "\\btypename\\b"
        }
      ]
    },

    "keywords_vop": {
      "comment": "VOP / arena keywords",
      "patterns": [
        {
          "name": "keyword.other.tunnel.cshift",
          "match": "\\btunnel\\b"
        },
        {
          "name": "keyword.other.reserve.cshift",
          "match": "\\breserve\\b"
        },
        {
          "name": "keyword.other.reset.cshift",
          "match": "\\breset\\b"
        }
      ]
    },

    "types_generic": {
      "comment": "Generic container types like Vector<int32>",
      "patterns": [
        {
          "match": "\\b(Vector|HashMap|LinkedList|Set|Deque|RingBuffer|Pool|Pair|Lazy|BitSet|Guard|StringBuilder|Buffer|SortedVec|VecIter)\\s*(<[^>]*>)?",
          "captures": {
            "1": { "name": "support.class.container.cshift" },
            "2": { "name": "support.type.template-args.cshift" }
          }
        }
      ]
    },

    "types_primitive": {
      "name": "support.type.primitive.cshift",
      "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|bool|char|string|voided)\\b"
    },

    "functions": {
      "comment": "Function calls and definitions",
      "patterns": [
        {
          "comment": "def / export def — highlight function name",
          "match": "\\b(?:export\\s+)?def\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.cshift" }
          }
        },
        {
          "comment": "Function calls",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.cshift" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tunnel-arrow.cshift",
          "match": "->"
        },
        {
          "name": "keyword.operator.scope.cshift",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.cshift",
          "match": "==|!=|<=|>=|<(?!<)|(?<!>)>"
        },
        {
          "name": "keyword.operator.logical.cshift",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.cshift",
          "match": "\\+=|-=|\\*=|/=|%=|<<=|>>=|\\*\\*=|="
        },
        {
          "name": "keyword.operator.bitshift.cshift",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.cshift",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.address.cshift",
          "match": "&(?![&])"
        },
        {
          "name": "keyword.operator.deref.cshift",
          "match": "\\*(?![=*])"
        }
      ]
    },

    "arena_ops": {
      "comment": "Array append operator and len operator",
      "patterns": [
        {
          "name": "keyword.operator.append.cshift",
          "match": "<<"
        },
        {
          "name": "keyword.operator.len.cshift",
          "match": "\\[\\[:\\]\\]"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cshift",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.cshift",
          "match": "\\bnull\\b"
        },
        {
          "comment": "SCREAMING_SNAKE_CASE identifiers are typically constants",
          "name": "variable.other.constant.cshift",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    }
  }
}
