{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "C<< (C-Shift)",
  "scopeName": "source.cshift",
  "fileTypes": ["cll"],
  "foldingStartMarker": "\\{\\s*$",
  "foldingStopMarker": "^\\s*\\}",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cshift",
          "match": "//.*$",
          "comment": "Single-line comments"
        },
        {
          "name": "comment.block.cshift",
          "begin": "/\\*",
          "end": "\\*/",
          "comment": "Multi-line comments"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cshift",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cshift",
              "match": "\\\\[\\\\\"ntrfbv0]"
            }
          ]
        },
        {
          "name": "string.raw.cshift",
          "begin": "raw<until\\s+\"",
          "end": "\">",
          "patterns": [
            {
              "name": "constant.character.raw.cshift",
              "match": "[^\"]*"
            }
          ]
        },
        {
          "name": "string.raw.lines.cshift",
          "match": "raw<\\d+>",
          "comment": "Raw string with line count"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cshift",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.cshift",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cshift",
          "match": "\\b(if|else|while|for|foreach|switch|case|default|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.cshift",
          "match": "\\b(def|struct|enum|namespace|const|reserve|import|entry)\\b"
        },
        {
          "name": "keyword.control.flow.cshift",
          "match": "\\b(tunnel|move|reset|valid|voided)\\b"
        },
        {
          "name": "keyword.template.cshift",
          "match": "\\b(template|typename)\\b"
        },
        {
          "name": "constant.language.boolean.cshift",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cshift",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|bool|char|string|voided)\\b"
        },
        {
          "name": "storage.type.pointer.cshift",
          "match": "\\*+",
          "comment": "Pointer dereference operator"
        },
        {
          "name": "storage.type.array.cshift",
          "match": "\\[.*?\\]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tunnel.cshift",
          "match": "->",
          "comment": "Tunnel operator"
        },
        {
          "name": "keyword.operator.scope.cshift",
          "match": "::",
          "comment": "Namespace resolution operator"
        },
        {
          "name": "keyword.operator.logical.cshift",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.cshift",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.cshift",
          "match": "(\\+=|-=|\\*=|/=|%=|<<=|>>=|\\*\\*=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.cshift",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.cshift",
          "match": "(&|<<|>>|\\?)",
          "comment": "Bitwise and shift operators"
        },
        {
          "name": "keyword.operator.dot.cshift",
          "match": "\\.",
          "comment": "Field access operator"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.def.cshift",
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.declaration.cshift"
            },
            "2": {
              "name": "entity.name.function.cshift"
            }
          }
        },
        {
          "name": "meta.function.call.cshift",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.cshift"
            }
          }
        }
      ]
    },
    "structs": {
      "patterns": [
        {
          "name": "meta.struct.cshift",
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.cshift"
            },
            "2": {
              "name": "entity.name.struct.cshift"
            }
          }
        },
        {
          "name": "meta.enum.cshift",
          "match": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.cshift"
            },
            "2": {
              "name": "entity.name.enum.cshift"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.cshift",
          "match": "\\b([A-Z][A-Z0-9_]*)\\b",
          "comment": "All-caps identifiers as constants"
        }
      ]
    }
  }
}
