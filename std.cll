// ============================================================
//  C<< Standard Library  —  std.cll
//  
//  Binds the full C standard library (libc) plus common POSIX
//  extensions. Just import this file and everything is available.
//
//  Usage:
//    import std;
//
//  The compiler resolves this at link time via -lc (automatic).
// ============================================================


// ════════════════════════════════════════════════════════════
//  §1  I/O  —  stdio.h
// ════════════════════════════════════════════════════════════

// --- Console output ---
import int32  printf    (string fmt, ...);
import int32  puts      (string s);
import int32  putchar   (int32 c);
import int32  fputs     (string s, voided* stream);
import int32  fputc     (int32 c, voided* stream);
import int32  print     (string fmt, ...); // prints all arguments like: print("Score: ", score, "\n");

// --- Console input ---
import int32  scanf     (string fmt, ...);
import int32  getchar   ();
import string gets_s    (string buf, int32 n);          // safe gets
import int32  getline_s (string* buf, uint64* n, voided* stream); // POSIX getline

// --- Formatted string ---
import int32  sprintf   (string buf, string fmt, ...);
import int32  snprintf  (string buf, uint64 n, string fmt, ...);
import int32  sscanf    (string buf, string fmt, ...);

// --- File I/O ---
import voided* fopen    (string path, string mode);
import int32   fclose   (voided* stream);
import uint64  fread    (voided* buf, uint64 size, uint64 n, voided* stream);
import uint64  fwrite   (voided* buf, uint64 size, uint64 n, voided* stream);
import int32   fseek    (voided* stream, int64 offset, int32 whence);
import int64   ftell    (voided* stream);
import voided  rewind   (voided* stream);
import int32   fflush   (voided* stream);
import int32   feof     (voided* stream);
import int32   ferror   (voided* stream);
import int32   fgetc    (voided* stream);
import string  fgets    (string buf, int32 n, voided* stream);
import int32   fprintf  (voided* stream, string fmt, ...);
import int32   fscanf   (voided* stream, string fmt, ...);

// --- File system ---
import int32   remove   (string path);
import int32   rename   (string old_path, string new_path);
import string  tmpnam   (string buf);
import voided* tmpfile  ();


// ════════════════════════════════════════════════════════════
//  §2  Memory  —  stdlib.h / string.h
// ════════════════════════════════════════════════════════════

// --- Allocation ---
import voided* malloc   (uint64 size);
import voided* calloc   (uint64 n, uint64 size);
import voided* realloc  (voided* ptr, uint64 new_size);
import voided  free     (voided* ptr);

// --- Memory ops ---
import voided* memcpy   (voided* dst, voided* src, uint64 n);
import voided* memmove  (voided* dst, voided* src, uint64 n);
import voided* memset   (voided* dst, int32 val, uint64 n);
import int32   memcmp   (voided* a, voided* b, uint64 n);
import voided* memchr   (voided* s, int32 c, uint64 n);


// ════════════════════════════════════════════════════════════
//  §3  Strings  —  string.h
// ════════════════════════════════════════════════════════════

import uint64  strlen   (string s);
import string  strcpy   (string dst, string src);
import string  strncpy  (string dst, string src, uint64 n);
import string  strcat   (string dst, string src);
import string  strncat  (string dst, string src, uint64 n);
import int32   strcmp   (string a, string b);
import int32   strncmp  (string a, string b, uint64 n);
import int32   strcasecmp (string a, string b);          // POSIX
import string  strchr   (string s, int32 c);
import string  strrchr  (string s, int32 c);
import string  strstr   (string haystack, string needle);
import string  strtok   (string s, string delim);
import string  strtok_r (string s, string delim, string* saveptr); // POSIX
import string  strdup   (string s);                     // POSIX
import string  strndup  (string s, uint64 n);           // POSIX
import string  strerror (int32 errnum);
import uint64  strspn   (string s, string accept);
import uint64  strcspn  (string s, string reject);
import string  strpbrk  (string s, string accept);


// ════════════════════════════════════════════════════════════
//  §4  Numbers & Math  —  stdlib.h / math.h
// ════════════════════════════════════════════════════════════

// --- String → number ---
import int32   atoi     (string s);
import int64   atol     (string s);
import int64   atoll    (string s);
import float64 atof     (string s);
import int64   strtol   (string s, string* end, int32 base);
import uint64  strtoul  (string s, string* end, int32 base);
import int64   strtoll  (string s, string* end, int32 base);
import uint64  strtoull (string s, string* end, int32 base);
import float64 strtod   (string s, string* end);
import float32 strtof   (string s, string* end);

// --- Number → string ---
import int32   itoa_s   (int32 val, string buf, uint64 bufsz, int32 base); // _itoa_s

// --- Integer math ---
import int32   abs      (int32 x);
import int64   labs     (int64 x);
import int64   llabs    (int64 x);
import int32   div_s    (int32 a, int32 b);             // maps to div()

// --- Floating point math (libm — link with -lm) ---
import float64 sqrt     (float64 x);
import float64 cbrt     (float64 x);
import float64 pow      (float64 base, float64 exp);
import float64 exp      (float64 x);
import float64 exp2     (float64 x);
import float64 log      (float64 x);
import float64 log2     (float64 x);
import float64 log10    (float64 x);
import float64 fabs     (float64 x);
import float64 ceil     (float64 x);
import float64 floor    (float64 x);
import float64 round    (float64 x);
import float64 trunc    (float64 x);
import float64 fmod     (float64 x, float64 y);
import float64 remainder(float64 x, float64 y);
import float64 fmin     (float64 x, float64 y);
import float64 fmax     (float64 x, float64 y);
import float64 hypot    (float64 x, float64 y);
import float64 sin      (float64 x);
import float64 cos      (float64 x);
import float64 tan      (float64 x);
import float64 asin     (float64 x);
import float64 acos     (float64 x);
import float64 atan     (float64 x);
import float64 atan2    (float64 y, float64 x);
import float64 sinh     (float64 x);
import float64 cosh     (float64 x);
import float64 tanh     (float64 x);
import float32 sqrtf    (float32 x);
import float32 powf     (float32 base, float32 exp);
import float32 fabsf    (float32 x);
import float32 ceilf    (float32 x);
import float32 floorf   (float32 x);
import float32 roundf   (float32 x);
import float32 sinf     (float32 x);
import float32 cosf     (float32 x);
import float32 tanf     (float32 x);

// --- Random ---
import int32   rand     ();
import voided  srand    (uint32 seed);
import float64 drand48  ();                             // POSIX
import voided  srand48  (int64 seed);                  // POSIX


// ════════════════════════════════════════════════════════════
//  §5  Process & Environment  —  stdlib.h / unistd.h
// ════════════════════════════════════════════════════════════

import voided  exit     (int32 code);
import voided  abort    ();
import voided  _exit    (int32 code);                   // POSIX
import int32   atexit   (voided* fn);
import string  getenv   (string name);
import int32   setenv   (string name, string val, int32 overwrite); // POSIX
import int32   unsetenv (string name);                  // POSIX
import int32   putenv   (string str);
import int32   system   (string cmd);

// --- Process info (POSIX) ---
import int32   getpid   ();
import int32   getppid  ();
import int32   getuid   ();
import int32   getgid   ();

// --- Fork/exec (POSIX) ---
import int32   fork     ();
import int32   execv    (string path, voided* argv);
import int32   execvp   (string file, voided* argv);
import int32   execve   (string path, voided* argv, voided* envp);
import int32   waitpid  (int32 pid, int32* status, int32 options);


// ════════════════════════════════════════════════════════════
//  §6  File System  —  unistd.h / sys/stat.h / dirent.h
// ════════════════════════════════════════════════════════════

import int32   open     (string path, int32 flags, ...);
import int32   close    (int32 fd);
import int64   read     (int32 fd, voided* buf, uint64 n);
import int64   write    (int32 fd, voided* buf, uint64 n);
import int64   lseek    (int32 fd, int64 offset, int32 whence);
import int32   unlink   (string path);
import int32   rmdir    (string path);
import int32   mkdir    (string path, uint32 mode);
import int32   rename_f (string old_p, string new_p);
import int32   access   (string path, int32 mode);
import int32   stat     (string path, voided* buf);
import int32   fstat    (int32 fd, voided* buf);
import int32   lstat    (string path, voided* buf);
import string  getcwd   (string buf, uint64 size);
import int32   chdir    (string path);
import int32   chmod    (string path, uint32 mode);
import int32   chown    (string path, uint32 uid, uint32 gid);
import int32   symlink  (string target, string linkpath);
import int32   readlink (string path, string buf, uint64 bufsiz);
import int32   truncate (string path, int64 length);
import int32   ftruncate(int32 fd, int64 length);

// --- Directory traversal ---
import voided* opendir  (string path);
import voided* readdir  (voided* dir);
import int32   closedir (voided* dir);


// ════════════════════════════════════════════════════════════
//  §7  Time  —  time.h / sys/time.h
// ════════════════════════════════════════════════════════════

import int64   time     (int64* t);
import voided* localtime(int64* t);
import voided* gmtime   (int64* t);
import uint64  strftime (string buf, uint64 max, string fmt, voided* tm);
import float64 difftime (int64 end, int64 start);
import int32   clock    ();                             // CPU ticks
import int32   gettimeofday (voided* tv, voided* tz);  // POSIX
import int32   nanosleep(voided* req, voided* rem);     // POSIX
import voided  sleep_ms (uint32 ms);                    // maps to usleep


// ════════════════════════════════════════════════════════════
//  §8  Sockets & Networking  —  sys/socket.h / netinet/in.h
// ════════════════════════════════════════════════════════════

import int32   socket   (int32 domain, int32 type, int32 protocol);
import int32   bind     (int32 fd, voided* addr, uint32 addrlen);
import int32   listen   (int32 fd, int32 backlog);
import int32   accept   (int32 fd, voided* addr, uint32* addrlen);
import int32   connect  (int32 fd, voided* addr, uint32 addrlen);
import int64   send     (int32 fd, voided* buf, uint64 len, int32 flags);
import int64   recv     (int32 fd, voided* buf, uint64 len, int32 flags);
import int64   sendto   (int32 fd, voided* buf, uint64 len, int32 flags, voided* addr, uint32 addrlen);
import int64   recvfrom (int32 fd, voided* buf, uint64 len, int32 flags, voided* addr, uint32* addrlen);
import int32   setsockopt(int32 fd, int32 level, int32 optname, voided* optval, uint32 optlen);
import int32   getsockopt(int32 fd, int32 level, int32 optname, voided* optval, uint32* optlen);
import int32   shutdown (int32 fd, int32 how);
import int32   getaddrinfo (string host, string service, voided* hints, voided** res);
import voided  freeaddrinfo(voided* res);
import string  gai_strerror(int32 err);
import int32   getnameinfo  (voided* addr, uint32 addrlen, string host, uint32 hostlen, string serv, uint32 servlen, int32 flags);
import uint32  htonl    (uint32 x);
import uint16  htons    (uint16 x);
import uint32  ntohl    (uint32 x);
import uint16  ntohs    (uint16 x);
import int32   inet_pton(int32 af, string src, voided* dst);
import string  inet_ntop(int32 af, voided* src, string dst, uint32 size);


// ════════════════════════════════════════════════════════════
//  §9  Threads  —  pthread.h  (link with -lpthread)
// ════════════════════════════════════════════════════════════

import int32   pthread_create  (voided* thread, voided* attr, voided* fn, voided* arg);
import int32   pthread_join    (voided* thread, voided** retval);
import int32   pthread_detach  (voided* thread);
import voided  pthread_exit    (voided* retval);
import voided* pthread_self    ();
import int32   pthread_cancel  (voided* thread);

import int32   pthread_mutex_init    (voided* mutex, voided* attr);
import int32   pthread_mutex_lock    (voided* mutex);
import int32   pthread_mutex_trylock (voided* mutex);
import int32   pthread_mutex_unlock  (voided* mutex);
import int32   pthread_mutex_destroy (voided* mutex);

import int32   pthread_rwlock_init    (voided* rwlock, voided* attr);
import int32   pthread_rwlock_rdlock  (voided* rwlock);
import int32   pthread_rwlock_wrlock  (voided* rwlock);
import int32   pthread_rwlock_unlock  (voided* rwlock);
import int32   pthread_rwlock_destroy (voided* rwlock);

import int32   pthread_cond_init    (voided* cond, voided* attr);
import int32   pthread_cond_wait    (voided* cond, voided* mutex);
import int32   pthread_cond_timedwait(voided* cond, voided* mutex, voided* abstime);
import int32   pthread_cond_signal  (voided* cond);
import int32   pthread_cond_broadcast(voided* cond);
import int32   pthread_cond_destroy (voided* cond);

import int32   sem_init    (voided* sem, int32 pshared, uint32 value);
import int32   sem_wait    (voided* sem);
import int32   sem_trywait (voided* sem);
import int32   sem_post    (voided* sem);
import int32   sem_destroy (voided* sem);


// ════════════════════════════════════════════════════════════
//  §10  Signals  —  signal.h
// ════════════════════════════════════════════════════════════

import voided* signal   (int32 signum, voided* handler);
import int32   raise    (int32 signum);
import int32   kill     (int32 pid, int32 signum);
import int32   sigaction(int32 signum, voided* act, voided* oldact);


// ════════════════════════════════════════════════════════════
//  §11  Memory Mapping  —  sys/mmap.h
// ════════════════════════════════════════════════════════════

import voided* mmap     (voided* addr, uint64 len, int32 prot, int32 flags, int32 fd, int64 offset);
import int32   munmap   (voided* addr, uint64 len);
import int32   mprotect (voided* addr, uint64 len, int32 prot);
import int32   msync    (voided* addr, uint64 len, int32 flags);
import int32   mlock    (voided* addr, uint64 len);
import int32   munlock  (voided* addr, uint64 len);


// ════════════════════════════════════════════════════════════
//  §12  Dynamic Linking  —  dlfcn.h  (link with -ldl)
// ════════════════════════════════════════════════════════════

import voided* dlopen   (string filename, int32 flags);
import voided* dlsym    (voided* handle, string symbol);
import int32   dlclose  (voided* handle);
import string  dlerror  ();


// ════════════════════════════════════════════════════════════
//  §13  Character Classification  —  ctype.h
// ════════════════════════════════════════════════════════════

import int32   isalpha  (int32 c);
import int32   isdigit  (int32 c);
import int32   isalnum  (int32 c);
import int32   isspace  (int32 c);
import int32   isupper  (int32 c);
import int32   islower  (int32 c);
import int32   ispunct  (int32 c);
import int32   isprint  (int32 c);
import int32   iscntrl  (int32 c);
import int32   isxdigit (int32 c);
import int32   toupper  (int32 c);
import int32   tolower  (int32 c);


// ════════════════════════════════════════════════════════════
//  §14  Error Handling  —  errno.h
// ════════════════════════════════════════════════════════════

import int32   perror_s (string msg);                   // maps to perror()
// errno is a macro in C — access it via a wrapper:
import int32   get_errno();                             // implement in frt.c


// ════════════════════════════════════════════════════════════
//  §15  Cryptography & Hashing  —  openssl/sha.h (optional)
//  Link with: -lssl -lcrypto
// ════════════════════════════════════════════════════════════

import voided* SHA256         (voided* data, uint64 len, voided* digest);
import voided* SHA512         (voided* data, uint64 len, voided* digest);
import voided* MD5            (voided* data, uint64 len, voided* digest);


// ════════════════════════════════════════════════════════════
//  §16  Regex  —  regex.h  (POSIX)
// ════════════════════════════════════════════════════════════

import int32   regcomp  (voided* preg, string pattern, int32 cflags);
import int32   regexec  (voided* preg, string string, uint64 nmatch, voided* pmatch, int32 eflags);
import voided  regfree  (voided* preg);
import uint64  regerror (int32 errcode, voided* preg, string errbuf, uint64 errbuf_size);


// ════════════════════════════════════════════════════════════
//  §17  Sorting & Searching  —  stdlib.h
// ════════════════════════════════════════════════════════════

import voided  qsort    (voided* base, uint64 n, uint64 size, voided* cmp);
import voided* bsearch  (voided* key, voided* base, uint64 n, uint64 size, voided* cmp);


// ════════════════════════════════════════════════════════════
//  §18  Locale  —  locale.h
// ════════════════════════════════════════════════════════════

import string  setlocale(int32 category, string locale);
import voided* localeconv();


// ════════════════════════════════════════════════════════════
//  §19  Wide Strings  —  wchar.h
// ════════════════════════════════════════════════════════════

import uint64  wcslen   (voided* s);
import voided* wcscpy   (voided* dst, voided* src);
import int32   wcscmp   (voided* a, voided* b);
import int32   wprintf  (voided* fmt, ...);
import int32   mbstowcs (voided* dst, string src, uint64 n);
import int32   wcstombs (string dst, voided* src, uint64 n);


// ════════════════════════════════════════════════════════════
//  §20  C<< Runtime Helpers  —  frt.c
//  These are thin wrappers that don't exist in libc directly.
//  Implement them in a small frt.c file linked with every binary.
// ════════════════════════════════════════════════════════════

// errno access (errno is a C macro, not a function)
import int32   get_errno   ();
import voided  set_errno   (int32 val);

// Safe integer overflow checks
import int32   add_i32_safe (int32 a, int32 b, int32* out);
import int32   mul_i32_safe (int32 a, int32 b, int32* out);

// Heap string builder (returns malloc'd string — caller must free)
import string  str_concat   (string a, string b);
import string  str_repeat   (string s, int32 n);
import string  str_slice    (string s, int32 start, int32 end);
import int32   str_index_of (string s, string needle);
import string  str_replace  (string s, string from, string to);
import string  int_to_str   (int64 val);
import string  float_to_str (float64 val, int32 precision);

// I/O helpers
import string  read_line    ();                  // reads one line from stdin, malloc'd
import string  read_file  (string path);       // entire file into malloc'd string
import int32   write_file (string path, string contents, string mode); // a or r (attach or replace)

// Timing
import float64 now_seconds  ();                  // monotonic clock in seconds
